# Normalização automática de finais de linha para LF em todo o projeto
* text=auto eol=lf

# Forçar explicitamente LF em ficheiros críticos para o servidor
*.php text eol=lf
*.conf text eol=lf
*.sh text eol=lf

# Definições de diff existentes
*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

# Ficheiros a ignorar na exportação
/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignoreS